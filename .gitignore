# Local .terraform directory (contains downloaded provider plugins and modules)
.terraform/

# .tfstate files (contains your infrastructure state, potentially secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (they likely contain passwords and private secrets)
*.tfvars
*.tfvars.json

# Ignore local override files 
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created during a terraform apply
.terraform.tfstate.lock.info

# Include tfplan files if you output plans locally (e.g., terraform plan -out=tfplan)
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

